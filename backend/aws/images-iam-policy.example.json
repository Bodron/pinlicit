{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageProductImages",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::YOUR_BUCKET/images/*"
    },
    {
      "Sid": "InventoryLegacyVideos",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::YOUR_BUCKET",
      "Condition": { "StringLike": { "s3:prefix": ["videos/", "videos/*"] } }
    },
    {
      "Sid": "DeleteLegacyVideos",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::YOUR_BUCKET/videos/*"
    }
  ]
}
