PORT=3000
MONGODB_URI=mongodb://localhost:27017/licit
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
APP_ORIGIN=http://localhost:3000,http://localhost:3001
AWS_REGION=eu-central-1
AWS_S3_BUCKET=licit-videos-dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PUBLIC_VIDEO_BASE_URL=
ANTI_SNIPE_WINDOW_SECONDS=60
ANTI_SNIPE_EXTENSION_SECONDS=60

# Stripe marketplace integration — disabled and sandbox-only in this release.
# Use a separate test database. Existing/legacy listings are not migrated.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TRANSFERS_ENABLED=false
# Explicit business policy; no default commission or timing is assumed.
# Basis points: 100 = 1%. Tests use fixture values, not a business decision.
STRIPE_PLATFORM_FEE_BPS=
STRIPE_PAYMENT_WINDOW_HOURS=
STRIPE_RELEASE_DELAY_HOURS=
STRIPE_MAX_FULFILLMENT_DAYS=
# Fixed HTTPS URLs hosted by our application, never supplied by clients.
STRIPE_IDENTITY_RETURN_URL=
STRIPE_CONNECT_RETURN_URL=
STRIPE_CONNECT_REFRESH_URL=
